      "html_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>5-Day Tokyo Cultural Trip Timeline</title>\n</head>\n<body style=\"margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,'Helvetica Neue',Arial; background:linear-gradient(180deg,#f7fbff,#ffffff);color:#0b1220; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;\">\n\n  <header style=\"padding:20px 16px 8px;max-width:1100px;margin:0 auto;\">\n    <h1 style=\"margin:0;font-size:clamp(1.25rem,2.4vw,2rem);line-height:1.05;color:#07203a;\">\n      5-Day Tokyo Cultural Immersion — Trip Plan\n    </h1>\n    <p style=\"margin:8px 0 0;color:#253244;font-size:clamp(0.9rem,1.6vw,1rem);\">\n      A day-by-day plan to explore Tokyo's neighborhoods, temples, traditional arts, cuisine and cultural experiences.\n    </p>\n  </header>\n\n  <main id=\"main\" role=\"main\" aria-labelledby=\"timeline-title\" style=\"max-width:1200px;margin:20px auto;padding:0 12px;\">\n    <h2 id=\"timeline-title\" style=\"position:absolute;left:-9999px;top:auto;\">Trip timeline</h2>\n\n    <section role=\"region\" aria-label=\"Horizontal timeline of trip days\" style=\"margin-top:18px;\">\n      <!-- Timeline container -->\n      <div role=\"list\" aria-label=\"Tokyo 5-day timeline\" style=\"position:relative; display:flex; align-items:center; gap:24px; padding:28px 12px; overflow-x:auto; scroll-behavior:smooth; -webkit-overflow-scrolling:touch;\">\n        <!-- Horizontal axis (decorative) -->\n        <div aria-hidden=\"true\" style=\"position:absolute; left:0; right:0; top:50%; transform:translateY(-50%); height:4px; background:linear-gradient(90deg,#e6eef8 0%, #cfe6fb 50%, #e6eef8 100%); border-radius:999px; z-index:0; pointer-events:none;\"></div>\n\n        <!-- Day 1 -->\n        <div role=\"listitem\" style=\"position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; min-width:clamp(240px,28vw,360px); flex:0 0 auto;\">\n          <div role=\"img\" aria-label=\"Day 1 marker\" style=\"width:20px;height:20px;border-radius:50%;background:#ff6b6b;box-shadow:0 0 0 8px rgba(255,107,107,0.08); margin-bottom:12px;\"></div>\n\n          <article aria-labelledby=\"day1-title\" tabindex=\"0\" style=\"background:#ffffff;border:1px solid rgba(7,32,58,0.06);box-shadow:0 6px 20px rgba(8,22,40,0.06);border-radius:12px;padding:16px; width:100%; display:grid; grid-template-rows:auto 1fr; gap:10px;\">\n            <header style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:8px;\">\n              <div>\n                <h3 id=\"day1-title\" style=\"margin:0;font-size:1.05rem;color:#07203a;\">Day 1 — Arrival & Neighborhood Walk</h3>\n                <p style=\"margin:6px 0 0;font-size:0.9rem;color:#3b4958;\">Settle into Tokyo and discover a nearby neighborhood on foot.</p>\n              </div>\n              <time datetime=\"2025-04-10\" style=\"font-size:0.85rem;color:#536171;\">Thu, Apr 10</time>\n            </header>\n\n            <div style=\"display:grid;gap:8px;font-size:0.95rem;color:#203142;\">\n              <ul style=\"margin:0;padding-left:18px;\">\n                <li style=\"margin-bottom:6px;\">Arrive at Haneda/Narita — transfer to accommodation in Asakusa.</li>\n                <li style=\"margin-bottom:6px;\">Walk around Senso-ji and Nakamise Street to observe traditional shops and snacks.</li>\n                <li style=\"margin-bottom:6px;\">Evening: riverside stroll at Sumida Park; informal reflection on first impressions.</li>\n              </ul>\n              <p style=\"margin:0;font-size:0.85rem;color:#445764;\">Focus: acclimate, observe everyday life and local rhythms.</p>\n            </div>\n          </article>\n        </div>\n\n        <!-- Day 2 -->\n        <div role=\"listitem\" style=\"position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; min-widt