ay: flex; align-items: center; justify-content: center; color: white; font-weight: bold; box-shadow: 0 4px 12px rgba(255,107,107,0.3);\">1</div>\n                    <div style=\"height: 200px; background: linear-gradient(135deg, #ff6b6b, #ee5a52); position: relative; overflow: hidden;\">\n                        <div style=\"position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 100 100\\\"><circle cx=\\\"20\\\" cy=\\\"20\\\" r=\\\"2\\\" fill=\\\"white\\\" opacity=\\\"0.3\\\"/><circle cx=\\\"80\\\" cy=\\\"40\\\" r=\\\"1.5\\\" fill=\\\"white\\\" opacity=\\\"0.2\\\"/><circle cx=\\\"40\\\" cy=\\\"70\\\" r=\\\"1\\\" fill=\\\"white\\\" opacity=\\\"0.4\\\"/></svg>'); opacity: 0.3;\"></div>\n                        <div style=\"position: absolute; bottom: 1rem; left: 1rem; color: white;\">\n                            <h2 id=\"day1-title\" style=\"margin: 0; font-size: 1.5rem; font-weight: 600;\">Traditional Temples</h2>\n                            <p style=\"margin: 0.5rem 0 0 0; opacity: 0.9;\">Spiritual Foundation</p>\n                        </div>\n                    </div>\n                    <div style=\"padding: 1.5rem;\">\n                        <div style=\"margin-bottom: 1rem;\">\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #ff6b6b; font-size: 1.1rem;\">Morning: Senso-ji Temple</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Explore Tokyo's oldest temple in Asakusa, experience traditional incense rituals, and browse Nakamise shopping street.</p>\n                        </div>\n                        <div>\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #ff6b6b; font-size: 1.1rem;\">Afternoon: Meiji Shrine</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Visit the serene shrine dedicated to Emperor Meiji, witness traditional Shinto ceremonies if available.</p>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Day 2 -->\n                <article style=\"flex: 0 0 300px; background: white; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.1); overflow: hidden; position: relative; transition: transform 0.3s ease;\" role=\"article\" aria-labelledby=\"day2-title\">\n                    <div style=\"position: absolute; top: -20px; left: 50%; transform: translateX(-50%); width: 40px; height: 40px; background: #4ecdc4; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; box-shadow: 0 4px 12px rgba(78,205,196,0.3);\">2</div>\n                    <div style=\"height: 200px; background: linear-gradient(135deg, #4ecdc4, #44a08d); position: relative; overflow: hidden;\">\n                        <div style=\"position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 100 100\\\"><rect x=\\\"10\\\" y=\\\"10\\\" width=\\\"15\\\" height=\\\"15\\\" fill=\\\"white\\\" opacity=\\\"0.2\\\"/><rect x=\\\"70\\\" y=\\\"30\\\" width=\\\"10\\\" height=\\\"10\\\" fill=\\\"white\\\" opacity=\\\"0.3\\\"/><rect x=\\\"30\\\" y=\\\"60\\\" width=\\\"12\\\" height=\\\"12\\\" fill=\\\"white\\\" opacity=\\\"0.25\\\"/></svg>'); opacity: 0.3;\"></div>\n                        <div style=\"position: absolute; bottom: 1rem; left: 1rem; color: white;\">\n                            <h2 id=\"day2-title\" style=\"margin: 0; font-size: 1.5rem; font-weight: 600;\">Art & Museums</h2>\n                            <p style=\"margin: 0.5rem 0 0 0; opacity: 0.9;\">Cultural Heritage</p>\n                        </div>\n                    </div>\n                    <div style=\"padding: 1.5rem;\">\n                        <div style=\"margin-bottom: 1rem;\">\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #4ecdc4; font-size: 1.1rem;\">Morning: Tokyo National Museum</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Discover Japan's largest collection of cultural artifacts, including samurai swords, ancient pottery, and Buddhist art.</p>\n                        </div>\n                        <div>\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #4ecdc4; font-size: 1.1rem;\">Afternoon: Ueno Park</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Stroll through cultural district, visit multiple museums, and experience traditional Japanese garden aesthetics.</p>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Day 3 -->\n                <article style=\"flex: 0 0 300px; background: white; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.1); overflow: hidden; position: relative; transition: transform 0.3s ease;\" role=\"article\" aria-labelledby=\"day3-title\">\n                    <div style=\"position: absolute; top: -20px; left: 50%; transform: translateX(-50%); width: 40px; height: 40px; background: #45b7d1; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; box-shadow: 0 4px 12px rgba(69,183,209,0.3);\">3</div>\n                    <div style=\"height: 200px; background: linear-gradient(135deg, #45b7d1, #2980b9); position: relative; overflow: hidden;\">\n                        <div style=\"position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 100 100\\\"><polygon points=\\\"20,10 30,30 10,30\\\" fill=\\\"white\\\" opacity=\\\"0.3\\\"/><polygon points=\\\"70,20 85,45 55,45\\\" fill=\\\"white\\\" opacity=\\\"0.2\\\"/><polygon points=\\\"40,60 50,80 30,80\\\" fill=\\\"white\\\" opacity=\\\"0.25\\\"/></svg>'); opacity: 0.3;\"></div>\n                        <div style=\"position: absolute; bottom: 1rem; left: 1rem; color: white;\">\n                            <h2 id=\"day3-title\" style=\"margin: 0; font-size: 1.5rem; font-weight: 600;\">Culinary Arts</h2>\n                            <p style=\"margin: 0.5rem 0 0 0; opacity: 0.9;\">Food Culture</p>\n                        </div>\n                    </div>\n                    <div style=\"padding: 1.5rem;\">\n                        <div style=\"margin-bottom: 1rem;\">\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #45b7d1; font-size: 1.1rem;\">Morning: Tsukiji Outer Market</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Experience authentic sushi breakfast, learn about Japanese ingredients, and observe traditional food preparation methods.</p>\n                        </div>\n                        <div>\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #45b7d1; font-size: 1.1rem;\">Evening: Cooking Class</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Hands-on experience making ramen, tempura, and traditional sweets with local chef guidance.</p>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Day 4 -->\n                <article style=\"flex: 0 0 300px; background: white; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.1); overflow: hidden; position: relative; transition: transform 0.3s ease;\" role=\"article\" aria-labelledby=\"day4-title\">\n                    <div style=\"position: absolute; top: -20px; left: 50%; transform: translateX(-50%); width: 40px; height: 40px; background: #96ceb4; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; box-shadow: 0 4px 12px rgba(150,206,180,0.3);\">4</div>\n                    <div style=\"height: 200px; background: linear-gradient(135deg, #96ceb4, #27ae60); position: relative; overflow: hidden;\">\n                        <div style=\"position: absolute; inset: 0; background: url('data:image/svg+xml,<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 100 100\\\"><path d=\\\"M20,20 Q30,10 40,20 T60,20\\\" stroke=\\\"white\\\" stroke-width=\\\"2\\\" fill=\\\"none\\\" opacity=\\\"0.3\\\"/><path d=\\\"M10,50 Q25,40 40,50 T70,50\\\" stroke=\\\"white\\\" stroke-width=\\\"1.5\\\" fill=\\\"none\\\" opacity=\\\"0.2\\\"/></svg>'); opacity: 0.3;\"></div>\n                        <div style=\"position: absolute; bottom: 1rem; left: 1rem; color: white;\">\n                            <h2 id=\"day4-title\" style=\"margin: 0; font-size: 1.5rem; font-weight: 600;\">Traditional Arts</h2>\n                            <p style=\"margin: 0.5rem 0 0 0; opacity: 0.9;\">Hands-on Learning</p>\n                        </div>\n                    </div>\n                    <div style=\"padding: 1.5rem;\">\n                        <div style=\"margin-bottom: 1rem;\">\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #96ceb4; font-size: 1.1rem;\">Morning: Tea Ceremony</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Learn the ancient art of Japanese tea ceremony, understand the philosophy of wa, kei, sei, jaku (harmony, respect, purity, tranquility).</p>\n                        </div>\n                        <div>\n                            <h3 style=\"margin: 0 0 0.5rem 0; color: #96ceb4; font-size: 1.1rem;\">Afternoon: Calligraphy Workshop</h3>\n                            <p style=\"margin: 0; font-size: 0.9rem; line-height: 1.4; color: #666;\">Practice shodo (Japanese calligraphy) with traditional brushes and ink, create your own artistic piece to take home.</p>\n                        </div>\n                    </div>\n                </article>\n\n                <!-- Day 5 -->\n                <